{#
  ANALYTICS TAGS — GA4 and Microsoft Clarity, for every layout's <head>, both
  behind the visitor's consent (see CONSENT below).

  Shared by layouts/base.njk and layouts/v4.njk so the two cannot drift: a page
  on either layout is measured the same way.
#}
{#- CONSENT (v4/consent.njk, scripts/v4-consent.js). Read first, so nothing
    sets a cookie before the visitor has said yes. "v4-consent" in
    localStorage is "granted" or "denied"; with no answer yet, it is denied.
    GA4 runs in Consent Mode: denied, it only sends cookieless pings; Clarity
    is not loaded at all until a yes. -#}
<script>
  // "THIS IS ME": no analytics at all in a browser of mine. Visiting the site
  // with ?me once marks this browser (localStorage "v4-me"); ?me=off clears
  // it. Localhost never counts. Then GA4, Clarity and Vercel Analytics never
  // load here (below, and layouts/v4.njk), whatever the IP.
  window.__notrack = (function () {
    try {
      var q = new URLSearchParams(location.search);
      if (q.has("me")) {
        if (q.get("me") === "off") localStorage.removeItem("v4-me");
        else localStorage.setItem("v4-me", "1");
        q.delete("me");
        var rest = q.toString();
        history.replaceState(null, "", location.pathname + (rest ? "?" + rest : "") + location.hash);
      }
      if (/^(localhost|127\.0\.0\.1|\[::1\])$|\.local$/.test(location.hostname)) return true;
      return localStorage.getItem("v4-me") === "1";
    } catch (e) { return false; }
  })();
  window.__consent = (function () { try { return localStorage.getItem("v4-consent") || ""; } catch (e) { return ""; } })();
  // A no closes the curtains on the visitor's sky too: the hero shows mine (v4/sky.njk).
  if (window.__consent === "denied") document.documentElement.classList.add("consent-denied");
  // No answer yet: the window stays shut until there is one.
  else if (window.__consent !== "granted") document.documentElement.classList.add("consent-pending");
</script>
{%- if site.analytics.ga4 %}
<script>
  // The tag itself, unless this browser is mine (window.__notrack above). The
  // consent calls below still queue harmlessly into dataLayer either way.
  if (!window.__notrack) {
    (function (s) { s.async = true; s.src = "https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4 }}"; document.head.appendChild(s); })(document.createElement("script"));
  }
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: window.__consent === 'granted' ? 'granted' : 'denied'
  });
  gtag('js', new Date());
  gtag('config', '{{ site.analytics.ga4 }}');
</script>
{%- endif %}

{#- MICROSOFT CLARITY — session recordings and heatmaps. Guarded on its own id
    exactly as GA is above, so emptying site.analytics.clarity removes the tag
    rather than shipping a broken one, and neither vendor's absence affects the
    other.

    EVERY PAGE, DELIBERATELY. Unlike the GA custom events in
    scripts/analytics-events.js, which branch on data-page, Clarity is only
    useful when it sees the whole journey — a recording that stops at a case
    study because the tag was homepage-only is worse than no recording.

    The tag inserts itself before the first <script> already in the document,
    which on this page is the GA loader; both are async and neither depends on
    the other. -#}
{%- if site.analytics.clarity %}
<script type="text/javascript">
  // Only after a yes: now if it was given before, or from the banner.
  window.__loadClarity = function () {
    if (window.clarity || window.__notrack) return;   // never in a browser of mine
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "{{ site.analytics.clarity }}");
    window.clarity("consent");
  };
  if (window.__consent === "granted") window.__loadClarity();
</script>
{%- endif %}
