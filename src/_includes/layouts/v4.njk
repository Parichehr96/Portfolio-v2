{#
  V4 LAYOUT — the light, single-column redesign (Figma B8Kfu0nGgUIG0REVlQTD5C).

  A SEPARATE LAYOUT, NOT A THEME OF base.njk, AND ON PURPOSE. V4 shares almost
  nothing with the V3 pages still on base.njk: no dark header, no hero, no
  parallax. Pointing base.njk's stylesheets at a new palette would restyle the
  three case studies that have not been redesigned yet. So V4 gets its own
  stylesheet entry (styles/v4/index.css) and its own short script list, and the
  V3 pages keep rendering exactly as they did until each one moves over.

  Shared with base.njk, so the two cannot drift: head-seo (meta, fonts) and
  head-analytics (GA4, Clarity).
#}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  {% include "partials/head-seo.njk" %}

  <link rel="stylesheet" href="/styles/v4/index.css" />
  {%- if (pageId or 'home') == 'home' %}
  {#- The homepage's entrance (_reveal.css, scripts/v4-reveal.js). Flagged
      here, before first paint, so the first screen's blocks start hidden and
      rise in by CSS alone, whatever the scripts do. Not for reduced motion. -#}
  <script>
    (function (d) {
      if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      d.classList.add("js-reveal");
    })(document.documentElement);
  </script>
  {%- endif %}

  {% include "partials/head-analytics.njk" %}
</head>

<body class="v4" data-page="{{ pageId or 'home' }}" id="top">
  {{ content | safe }}

  <script defer src="/scripts/mailto-fallback.js"></script>
  <script defer src="/scripts/clock.js"></script>
  <script defer src="/scripts/v4-toast.js"></script>
  <script defer src="/scripts/v4-rail.js"></script>
  <script defer src="/scripts/v4-strip.js"></script>
  <script defer src="/scripts/v4-progress.js"></script>
  <script defer src="/scripts/v4-clock-dock.js"></script>
  <script defer src="/scripts/v4-folders.js"></script>
  <script defer src="/scripts/v4-photos.js"></script>
  <script defer src="/scripts/v4-reveal.js"></script>

  {%- if site.analytics.vercel %}
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
  {%- endif %}
</body>
</html>
