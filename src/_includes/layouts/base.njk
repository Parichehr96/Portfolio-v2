{#
  BASE LAYOUT — <head>, the site header, <main>, scripts.

  Every page passes through here. Front matter switches the parts that vary:
    nav: false      drop the site header
    bodyClass       extra class on <body>
    pageId          data-page value, used by scripts to scope behaviour

  THE SCRIPT LIST IS DELIBERATELY SHORT. The cleanup sweep deleted eight
  modules with it — reveal, cursor, nav, carousel, timeline, snake, progress
  and radial-fill. Five of those were ALREADY inert before they were removed:
  the Phase 0 scaffold renamed the markup hooks they query without updating
  them, so each returned at its first guard on every page. Do not re-add one
  because a new section "probably needs it"; they are on main's history and
  every one of them queries selectors this design no longer emits.

  STYLESHEET ORDER IS LOAD-BEARING: tokens → base → components. Components read
  the custom properties tokens.css defines, so a component file loaded first
  would resolve every var() to nothing and render unstyled.
#}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  {% include "partials/head-seo.njk" %}

  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/base.css" />
  <link rel="stylesheet" href="/styles/components/index.css" />

  {%- if site.analytics.ga4 %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4 }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.analytics.ga4 }}');
  </script>
  {%- endif %}
</head>

<body data-page="{{ pageId or 'home' }}"{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {# The header is page furniture and sits ABOVE <main>, unlike the v2 bottom
     nav it replaces — that one lived inside <main> to stay in the same stacking
     context as the expanding footer card. This one is in normal flow and needs
     no z-index relationship with anything. #}
  {%- if nav != false %}
    {% include "partials/nav.njk" %}
  {%- endif %}

  <main>
    {{ content | safe }}
  </main>

  <script src="/scripts/app.js"></script>
  <script defer src="/scripts/mailto-fallback.js"></script>
  <script defer src="/scripts/button-fill.js"></script>
  <script defer src="/scripts/clock.js"></script>
  {# draggable.js MUST load before hero-folder.js: it publishes window.HeroDrag,
     which hero-folder.js reads. Both are `defer`, so they run in document
     order. #}
  <script defer src="/scripts/draggable.js"></script>
  <script defer src="/scripts/hero-folder.js"></script>
  <script defer src="/scripts/hero-icons.js"></script>
  <script defer src="/scripts/work-motion.js"></script>
  <script defer src="/scripts/analytics-events.js"></script>

  {%- if site.analytics.vercel %}
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
  {%- endif %}
</body>
</html>
