---
layout: layouts/v4.njk
---
{#
  V4 CASE STUDY — Figma 918:34271 (ONTON), the template for every V4 case.

  The page sets `caseKey` in front matter; everything it shows comes from
  _data/cases/<caseKey>.js. This file decides only structure:

    menu (left, sticky)        the site menu, always open, Work listing
                               every case study (this one lit)
    contents (right, sticky)   reading progress and this case's sections,
                               the one being read lit
    bar (sticky, see-through)  Back and Next, pinned either side of the
                               column; the name below them scrolls away
                               with the page, and the reading progress
                               sits at the top of the rail
    header                     cover, facts table
    hook                       the one-line claim, in a bar
    sections                   numbered automatically, each with optional blocks
    footer                     the shared V4 footer

  Wide blocks (metrics, competitors, what changed) stay in the 600px column
  and scroll sideways; see _case.css. Nothing enters the margins, which is
  what lets Back and Next float there with no ground behind them.
#}
{%- set c = cases[caseKey] -%}
{#- BACK goes to this case study's card on the homepage (/#work-<id>, the id
    on v4/project-row.njk; scripts/v4-rail.js makes the jump). NEXT goes to the
    next case study in the homepage's order (home.work.projects; live ones, with
    a page and not `soon`); the last has none. -#}
{%- set live = [] -%}
{%- for p in home.work.projects -%}{%- if p.href and not p.soon -%}{%- set live = live.concat([p]) -%}{%- endif -%}{%- endfor -%}
{%- set backHref = "/#work-" + caseKey -%}
{%- set nextHref = "" -%}
{%- for p in live -%}
  {%- if p.id == caseKey and not loop.last -%}{%- set nextHref = live[loop.index0 + 1].href -%}{%- endif -%}
{%- endfor -%}

<div class="v4-shell v4-shell--case">
  {#- The site menu on the left, this case's sections and progress on the
      right (v4/case-nav.njk). -#}
  {% include "v4/case-nav.njk" %}

  <article class="v4-case" data-read-article>
    {#- THE BAR: Back and Next, either side of the name's row. A see-through
        layer over the whole article whose row sticks at the top, so on wide
        screens the two stay in the margins while the page, the name included,
        scrolls past between them. Below 1200 there are no margins: the row
        stays put and scrolls away with the name. -#}
    <div class="v4-case__bar">
      <div class="v4-case__bar-inner">
        <a class="v4-case__back" href="{{ backHref }}">
          <img src="/Assets/v4/case/back.svg" width="20" height="20" alt="" />
          {{ c.back.label }}
        </a>
        {%- if nextHref %}
        <a class="v4-case__next" href="{{ nextHref }}">
          {{ c.next.label }}
          <img src="/Assets/v4/case/next.svg" width="20" height="20" alt="" />
        </a>
        {%- endif %}
      </div>
    </div>

    <div class="v4-case__title-row">
      <h1 class="v4-case__name">{{ c.name }}</h1>
    </div>

    <header class="v4-case__head">
      {%- set part = c.hero %}
      {#- An image by default; a case can give its cover a `type` (animation). -#}
      {% include "v4/case/" + (part.type or "image") + ".njk" %}

      <dl class="v4-case__facts">
        {%- for row in c.meta %}
        <div class="v4-case__fact">
          <dt>{{ row.label }}</dt>
          {%- if row.chip %}
          <dd><span class="v4-case__chip">{{ row.chip }}</span></dd>
          {%- else %}
          <dd><span class="v4-case__fact-value">{% for v in row.values %}<span>{{ v }}</span>{% endfor %}</span></dd>
          {%- endif %}
        </div>
        {%- endfor %}
      </dl>
    </header>

    <p class="v4-case__hook">{{ c.hook }}</p>

    {%- for section in c.sections %}
    <section class="v4-case__section" id="{{ section.title | slugify }}" aria-labelledby="{{ section.title | slugify }}-title">
      <h2 class="v4-case__heading" id="{{ section.title | slugify }}-title">
        <span class="v4-case__num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
        {{ section.title }}
      </h2>
      {%- if section.text %}
      <p class="v4-case__text{% if section.muted %} v4-case__text--muted{% endif %}">{{ section.text }}</p>
      {%- endif %}
      {%- if section.paragraphs %}
      <div class="v4-case__text v4-case__text--stack">
        {%- for p in section.paragraphs %}<p>{{ p }}</p>{% endfor %}
      </div>
      {%- endif %}
      {%- for part in section.blocks %}
      {% include "v4/case/" + part.type + ".njk" %}
      {%- endfor %}
    </section>
    {%- endfor %}
  </article>
</div>

{% include "v4/footer.njk" %}
