{#
  TOP BAND — Figma 911:547 (intro), 911:577 (status clock). With the rail (v4/rail.njk) all four share the comp's y=132 edge.

  THE INTRO IS THE PAGE'S 600px READING COLUMN (456px in at 1512, which is
  the comp). It scrolls with the page.

  THE CLOCK lives at the bottom of the left panel (index.njk, v4/status.njk).
  The right-hand track below only holds it on narrow screens, where there is
  no left panel: there it drops into the flow under the intro.

#}
<header class="v4-top">
  <div class="v4-intro">
    <div class="v4-intro__head">
      {#- 1155:10698: the logo follows the name, 4px on, centred on its line. -#}
      <h1 class="v4-intro__name">
        {{ site.name }}
        {#- Inline so it can draw itself in at load (_reveal.css): each shape's
            outline is traced, then filled. Same paths as icons/logo.svg. -#}
        <svg class="v4-intro__logo" width="12.5" height="17.36" viewBox="0 0 12.4983 17.3642" aria-hidden="true" focusable="false">
          <path pathLength="1" d="M11.6038 5.78824C11.6038 8.12329 10.217 10.1365 8.22075 11.0499C9.06368 10.3572 9.60047 9.30635 9.60047 8.13035C9.60047 6.06447 7.9434 4.38447 5.8816 4.34259C5.85425 4.34071 5.82924 4.34071 5.80189 4.34071C5.77453 4.34071 5.74953 4.34071 5.72217 4.34259C4.95708 4.384 4.35141 5.01553 4.35141 5.78777V13.0231C4.35141 15.4198 2.40236 17.3642 0 17.3642V5.78824C0 2.592 2.59811 0 5.80189 0C9.00566 0 11.6038 2.592 11.6038 5.78824Z"/>
          <path pathLength="1" d="M6.57724 7.68237C7.39208 6.61567 7.82721 4.92623 7.20531 4.30579C6.5834 3.68534 5.23709 4.02255 4.19823 5.05896C3.15938 6.09537 2.94826 8.56193 3.57017 9.18237C4.19208 9.80282 5.78142 8.72419 6.57724 7.68237Z"/>
          <path pathLength="1" d="M8.83254 14.4323C8.58195 13.9323 8.08077 12.4323 8.23672 11.3058C8.23672 12.1823 8.58195 13.1823 9.08313 13.9323C9.67612 14.8197 11.0878 15.6823 11.8719 16.1823C10.5867 15.9323 9.08313 14.9323 8.83254 14.4323Z"/>
        </svg>
      </h1>
      <p class="v4-intro__bio">
        {{- home.intro.bio.before -}}
        <strong>{{ home.intro.bio.strong }}</strong>
        {{- home.intro.bio.after -}}
      </p>
    </div>
    <div class="v4-intro__meta">
      <p class="v4-intro__location">
        <img src="/Assets/v4/icons/flag-nl.svg" width="16" height="16" alt="" />
        {{ home.intro.location }}
      </p>
      <a class="v4-intro__email" href="mailto:{{ site.email }}">
        {{ site.email }}
        <img src="/Assets/v4/icons/arrow-up-right.svg" width="12" height="12" alt="" />
      </a>
    </div>
  </div>
</header>

<div class="v4-aside-track">
  {#- Empty on wide screens: the clock lives at the bottom of the left panel
      (index.njk). Below 1200 scripts/v4-clock-dock.js moves it in here, under
      the intro. -#}
  <div class="v4-aside" data-clock-home></div>
</div>
