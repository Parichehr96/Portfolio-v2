{#
  WORK — Figma 1155:10689 ("Selected project" label) and 911:730 (the rows).

  Inside .v4-shell, so the sticky rail and clock keep riding down beside it.
  The rows come from home.work.projects; each is v4/project-row.njk, and each
  row that has a `label` draws it above itself (only the first: "Selected
  project").
#}
<section class="v4-work" id="work" aria-label="Work">
  {%- for project in home.work.projects %}
  {#- The first row is on screen at load, so its images (both sets) load at
      once; later rows stay lazy. -#}
  {%- set eager = loop.first %}
  {% include "v4/project-row.njk" %}
  {%- endfor %}
</section>
