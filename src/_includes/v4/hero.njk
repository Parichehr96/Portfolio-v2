{#
  HERO — redesign 1669:6413, the first screen. "Product Designer", the bio,
  where I'm based and the resume on the left; on the right, the particles
  (scripts/v4-dots.js): black dots floating and morphing like a lava lamp,
  tidying into a coloured radial system (Figma 1677:9917), turning once
  around its centre, then loosening again, on a loop. The projects card
  follows close under it (1669:8785, 147 below the words).
  Phones: the text, then the particles.
#}
<header class="v5-hero" id="hero">
  <div class="v5-hero__text">
    <h1 class="v5-hero__title">{{ home.hero.title[0] }}<br>{{ home.hero.title[1] }}</h1>
    <p class="v5-hero__bio">
      {{- home.intro.bio.before | trim -}}<br>
      <strong>{{ home.intro.bio.strong }}</strong>
      {{- home.intro.bio.after -}}
    </p>
    <p class="v5-hero__location">
      <img src="/Assets/v5/location.svg" width="16" height="16" alt="" />
      {{ home.intro.location }}
    </p>
    <a class="v5-hero__resume" href="{{ site.resume.url }}" download="{{ site.resume.filename }}">
      {{ home.hero.resume }}
      <img src="/Assets/v5/download.svg" width="16" height="16" alt="" />
    </a>
  </div>
  <div class="v5-hero__dots" aria-hidden="true">
    <canvas data-dots></canvas>
  </div>
</header>
