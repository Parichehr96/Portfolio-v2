{#- Related case — a card that sends the reader to the companion case study
    (Connect2WOW ↔ WOW design system). Sits in the column like any block. -#}
<a class="v4-related" href="{{ part.href }}">
  <span class="v4-related__eyebrow">{{ part.eyebrow }}</span>
  <span class="v4-related__title">{{ part.title }}</span>
  <span class="v4-related__text">{{ part.text }}</span>
  <span class="v4-related__cta">{{ part.cta }} <img src="/Assets/v4/case/next.svg" width="16" height="16" alt="" /></span>
</a>
