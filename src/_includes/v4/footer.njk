{#
  FOOTER — Figma 1490:17162. The call to action, socials, the build stamp,
  and a full-colour illustration of Amsterdam canal houses and a bridge
  along the bottom.

  Carries #contact, so any "Contact" link lands here. "Last updated" and the
  year come from _data/build.js, so they are true on every deploy.

  The illustration is the comp's vector (1410:1331), 1512 x 326, the page's width, centred and
  anchored to the footer's bottom edge; it loads lazily, being last. Its
  tree crowns are tagged (class="tree", a pivot at each crown's base), and
  scripts/v4-wind.js swaps the image for the inline SVG so they can sway
  with Amsterdam's wind right now. Behind it stands the windmill
  (v4/windmill.njk), turning in the same wind.
#}
<footer class="v4-footer{% if footerSky %} v5-footer{% endif %}" id="contact">
  {% include "v4/windmill.njk" %}
  <div class="v4-mill-tip" role="tooltip" hidden data-mill-tip></div>
  <div class="v4-footer__sky" aria-hidden="true" data-wind-art>
    <img src="/Assets/v4/footer/amsterdam.svg" width="1512" height="326" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="v4-footer__content">
    {%- if footerSky %}
    {#- The redesign (1669:9587): the visitor's sky, its note above it, first in the footer. #}
    {% include "v4/sky.njk" %}
    {%- endif %}
    <div class="v4-footer__cta">
      <div class="v4-footer__text">
        <h2 class="v4-footer__title">{{ home.footer.title }}</h2>
        <p class="v4-footer__body">{{ home.footer.body }}</p>
      </div>
      <a class="v4-footer__button" href="{{ home.footer.cta.url }}" target="_blank" rel="noopener">
        {{ home.footer.cta.label }}
        <img src="/Assets/v4/footer/call-dot.svg" width="11" height="7" alt="" />
      </a>
    </div>
    <div class="v4-footer__meta">
      <ul class="v4-footer__socials">
        {%- for s in home.footer.socials %}
        {%- set mail = s.url.startsWith("mailto:") %}
        <li><a href="{{ s.url }}"{% if not mail %} target="_blank" rel="noopener"{% endif %} aria-label="{{ s.name }}{% if mail %} {{ s.url | replace('mailto:', '') }}{% endif %}"><img src="{{ s.icon }}" alt="" /></a></li>
        {%- endfor %}
      </ul>
      <p class="v4-footer__updated">Last updated: {{ build.updated }}</p>
      <p class="v4-footer__copy">&copy;{{ build.year }} {{ home.footer.owner }} · <button class="v4-footer__consent" type="button" data-consent-open>{{ home.consent.settings }}</button></p>
    </div>
  </div>
</footer>
