{#
  CASE STUDY MENUS — layouts/v4-case.njk.

  LEFT, at the top: Back (to this case's card on the homepage) and, under
  it, where you are: Home / Works / this case. On phones the two sit in the
  white top bar.

  RIGHT, where the homepage has the clock: the reading progress (the "23%"
  pill, scripts/v4-progress.js) and this case's sections, the one being read
  lit by the scroll-spy (scripts/v4-rail.js). From 1280 up only.

  Expects `c` (the case), `caseKey` and `backHref`.
#}
<div class="v4-rail-track">
  <nav class="v4-rail v4-case__crumbs" aria-label="Breadcrumb">
    <a class="v4-case__back" href="{{ backHref }}">
      <img src="/Assets/v4/case/back.svg" width="20" height="20" alt="" />
      {{ c.back.label }}
    </a>
    <ol class="v4-crumbs">
      <li><a href="/">Home</a></li>
      <li><a href="/#work">Works</a></li>
      <li aria-current="page">{{ c.name }}</li>
    </ol>
  </nav>
</div>

<div class="v4-rail-track v4-rail-track--right">
  <nav class="v4-rail" aria-label="On this page">
    <span class="v4-case__progress v4-rail__progress" data-read-progress aria-hidden="true">0%</span>
    <ul class="v4-rail__list">
      {%- for section in c.sections %}
      <li>
        <a class="v4-rail__item{% if loop.first %} is-active{% endif %}" href="#{{ section.title | slugify }}" data-rail-target="{{ section.title | slugify }}"{% if loop.first %} aria-current="true"{% endif %}>
          <span class="v4-rail__mark" aria-hidden="true"></span>
          {{ section.nav or section.title }}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </nav>
</div>
