{#
  PROJECT ROW — Figma 911:757 (Connect2WOW), reused for every project.
  Expects `project` from home.work.projects.

  THE HEADER sits in the 600px reading column, like the intro above it.

  THE STRIP runs as the comp draws it: from the 40px edge off the right side of
  the page, over the sticky rail and clock as they scroll past. It drifts
  slowly left to right on its own, forever: the panels are rendered twice
  (the second set aria-hidden) and the track slides by exactly one set, so the
  jump back to the start lands on an identical frame and is never seen. Hover
  pauses it; with reduced motion it stands still and scrolls by hand instead.
#}
{%- if project.label %}
<h2 class="v4-label">{{ project.label }}</h2>
{%- endif %}
<article class="v4-project" aria-labelledby="project-{{ project.id }}">
  <header class="v4-project__head">
    <div class="v4-project__title-row">
      <h3 class="v4-project__name" id="project-{{ project.id }}">
        {%- if project.href %}
        <a class="v4-project__link" href="{{ project.href }}">{{ project.name }}</a>
        {%- else %}
        <span class="v4-project__link">{{ project.name }}</span>
        {%- endif %}
        {%- if project.verified %}
        <img class="v4-project__verified" src="/Assets/v4/icons/verified.svg" width="16" height="16" alt="Shipped" />
        {%- endif %}
      </h3>
      <p class="v4-project__years">{{ project.years }}</p>
    </div>
    <p class="v4-project__desc">
      {%- for run in project.desc -%}
      {%- if run.style -%}<strong class="v4-project__{{ run.style }}">{{ run.text }}</strong>{%- else -%}{{ run.text }}{%- endif -%}
      {%- endfor -%}
    </p>
  </header>

  <div class="v4-project__strip" role="region" aria-label="{{ project.name }} screens">
    <div class="v4-project__track" style="--panels: {{ project.panels | length }}">
      {%- for copy in [false, true] %}
      {%- for panel in project.panels %}
      <figure class="v4-project__panel{% if not panel.src %} v4-project__panel--empty{% endif %}{% if copy %} v4-project__panel--clone{% endif %}"{% if copy %} aria-hidden="true"{% endif %}>
        {%- if panel.src %}
        <img src="{{ panel.src }}" width="812" height="520" alt="{{ '' if copy else panel.alt }}"{% if not eager %} loading="lazy"{% endif %} decoding="async" />
        {%- endif %}
      </figure>
      {%- endfor %}
      {%- endfor %}
    </div>
  </div>
</article>
