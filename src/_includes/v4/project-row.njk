{#
  PROJECT ROW — Figma 911:757 (Connect2WOW), reused for every project.
  Expects `project` from home.work.projects.

  THE HEADER sits in the 600px reading column, like the intro above it.

  THE STRIP runs as the comp draws it: from the reading column's left edge,
  cut off at its right. It is an endless carousel (scripts/v4-strip.js): one
  small swipe, scroll or drag moves it one thumbnail either way, and the
  thumbnail at the front plays its motion (panel.motion: "frames", stills
  played by steps, or "layers" appearing one by one). Without the script it
  is a plain horizontal scroller, each thumbnail on its first still.
#}
{%- if project.label %}
<h2 class="v4-label">{{ project.label }}</h2>
{%- endif %}
{%- set linked = project.href and not project.soon %}
{#- A linked project is clickable as a whole card (name, text and strip),
    scripts/v4-strip.js; the name stays the real link for keyboards and
    screen readers. -#}
<article class="v4-project{% if linked %} v4-project--linked{% endif %}" aria-labelledby="project-{{ project.id }}"{% if linked %} data-card-href="{{ project.href }}"{% endif %}>
  <header class="v4-project__head">
    <div class="v4-project__title-row">
      <h3 class="v4-project__name" id="project-{{ project.id }}">
        {%- if linked %}
        <a class="v4-project__link" href="{{ project.href }}">{{ project.name }}</a>
        {%- else %}
        <span class="v4-project__link">{{ project.name }}</span>
        {%- endif %}
        {%- if project.verified %}
        <img class="v4-project__verified" src="/Assets/v4/icons/verified.svg" width="16" height="16" alt="Shipped" />
        {%- endif %}
        {%- if project.soon %}
        <span class="v4-project__soon">(Coming Soon)</span>
        {%- endif %}
      </h3>
      <p class="v4-project__years">{{ project.years }}</p>
    </div>
    <p class="v4-project__desc">
      {%- for run in project.desc -%}
      {%- if run.style -%}<strong class="v4-project__{{ run.style }}">{{ run.text }}</strong>{%- else -%}{{ run.text }}{%- endif -%}
      {%- endfor -%}
    </p>
  </header>

  <div class="v4-project__strip" data-strip role="region" aria-label="{{ project.name }} screens">
    <div class="v4-project__track">
      {%- for panel in project.panels %}
      <figure class="v4-project__panel{% if panel.motion %} v4-project__panel--{{ panel.motion }}{% endif %}{% if not panel.src and not panel.layers and not panel.frames %} v4-project__panel--empty{% endif %}" style="--n: {{ 8 + loop.index }}{% if panel.bg %}; background: {{ panel.bg }}{% endif %}"{% if panel.steps %} data-steps="{{ panel.steps | dump | escape }}"{% endif %}>
        {%- if panel.frames %}
        <div class="v4-project__frames" role="img" aria-label="{{ panel.alt }}">
          {%- for frame in panel.frames %}
          <img class="v4-project__frame{% if loop.first %} is-on{% endif %}" src="{{ frame }}" width="812" height="520" alt=""{% if not eager %} loading="lazy"{% endif %} decoding="async" />
          {%- endfor %}
        </div>
        {%- elif panel.layers %}
        <div class="v4-project__layers" role="img" aria-label="{{ panel.alt }}">
          {%- for layer in panel.layers %}
          <img class="v4-project__layer" style="--i: {{ loop.index0 }}" src="{{ layer }}" width="812" height="520" alt=""{% if not eager %} loading="lazy"{% endif %} decoding="async" />
          {%- endfor %}
        </div>
        {%- elif panel.src %}
        <img src="{{ panel.src }}" width="812" height="520" alt="{{ panel.alt }}"{% if not eager %} loading="lazy"{% endif %} decoding="async" />
        {%- endif %}
      </figure>
      {%- endfor %}
    </div>
  </div>
</article>
