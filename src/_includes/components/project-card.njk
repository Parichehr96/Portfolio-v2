{#
  PROJECT CARD — takes one entry from _data/projects.js.

  The WHOLE card is the click target, so the "Explore X" line renders as a
  <span> via link(as="span") — nesting an <a> inside an <a> is invalid HTML and
  browsers unnest it, which silently shrinks the hit area to just that line.

  A project with no case study yet (url: null) renders as a non-interactive
  <div>: no href, no pointer, no keyboard stop. The old markup used href="#",
  which put a dead link in the tab order that scrolled the page to the top when
  activated.

  The image slot is intentionally EMPTY when `thumb` is null — thumbnails were
  removed from the design, and the fixed slot height is what keeps every card
  the same height so the carousel never jumps mid-scroll.

  PROPS
    project  one object from projects.js (required)
    class    extra classes
#}

{% from "components/link.njk" import link %}

{% macro projectCard(project, class="") %}
  {%- set interactive = project.url -%}
  {%- set tag = "a" if interactive else "div" -%}
  <{{ tag }}
    class="project-card{% if not interactive %} project-card--soon{% endif %}{% if class %} {{ class }}{% endif %}"
    {%- if interactive %} href="{{ project.url }}"{% endif %}
    data-project="{{ project.slug }}">
    <div class="project-card-media"{% if not project.thumb %} aria-hidden="true"{% endif %}>
      {%- if project.thumb %}
        <img src="{{ project.thumb }}" alt="{{ project.title }}" loading="lazy" />
      {%- endif %}
    </div>
    <div class="project-card-meta">
      <p class="project-card-caption">{{ project.caption }}</p>
      {%- if interactive %}
        {{ link("Explore " + project.title, as="span", class="project-card-link") }}
      {%- else %}
        <span class="project-card-link project-card-link--muted">Coming soon</span>
      {%- endif %}
    </div>
  </{{ tag }}>
{% endmacro %}
