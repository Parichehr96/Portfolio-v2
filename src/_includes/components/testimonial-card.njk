{#
  TESTIMONIAL CARD — one recommendation.

  The quote is CLAMPED here, not in the data: _data/testimonials.js keeps the
  full text so the same entry can feed a future full-quote page without a second
  copy drifting out of sync. `clamp` chooses how many characters the card shows.

  The role line carries a title attribute because these job titles are long and
  the card truncates them to one line.

  PROPS
    t      one object from testimonials.js (required)
    clamp  characters before the ellipsis (default 180); 0 = show it all
#}

{% from "components/link.njk" import link %}

{% macro testimonialCard(t, clamp=180) %}
  <article class="testimonial-card">
    <p class="testimonial-quote">{{ t.quote | truncate(clamp) if clamp else t.quote }}</p>
    <div class="testimonial-details">
      <div class="testimonial-id">
        {%- if t.avatar %}
          <img class="testimonial-avatar" src="{{ t.avatar }}" alt="" loading="lazy" width="40" height="40" />
        {%- endif %}
        <div class="testimonial-id-text">
          <p class="testimonial-name">{{ t.name }}</p>
          <p class="testimonial-role" title="{{ t.role }}">{{ t.role }}</p>
        </div>
      </div>
      {{ link(t.linkLabel, href=t.link, external=true, class="testimonial-link") }}
    </div>
  </article>
{% endmacro %}
