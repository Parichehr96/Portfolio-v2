{% macro icon(name, size=24, rotate=0, class="", title="", box="") %}
  {#
    Three viewBoxes: the chevron is on a 28-unit grid, the wordmark on 40,
    everything else on 24 — the three brand chips included. Sizing is handled by
    width/height, so the difference is invisible to callers, but it must be
    honoured here or the glyph crops.

    THE `box` OVERRIDE exists for one caller. The wordmark's 40-unit grid carries
    about 5 units of empty margin on every side, which is right in the header
    where the mark is optically centred in a fixed square. The footer needs the
    opposite: the DRAWN glyph placed to the comp's millimetre against the band's
    right edge, and invisible padding would push it off by ~100px. Passing the
    glyph's measured bounds as the viewBox makes the box and the artwork the same
    rectangle, so CSS positions what the eye sees. Defaults to empty, so every
    existing call is untouched.
  #}
  {%- if box -%}
  {%- elif name == "chevron-down" -%}{%- set box = "0 0 28 28" -%}
  {%- elif name == "logo-mark" -%}{%- set box = "0 0 40 40" -%}
  {%- else -%}{%- set box = "0 0 24 24" -%}{%- endif -%}
  <svg
    class="icon icon--{{ name }}{% if class %} {{ class }}{% endif %}"
    width="{{ size }}" height="{{ size }}" viewBox="{{ box }}"
    fill="none" focusable="false"
    {%- if rotate %} style="transform: rotate({{ rotate }}deg)"{% endif %}
    {%- if title %} role="img" aria-label="{{ title }}"{% else %} aria-hidden="true"{% endif %}>
    {{- paths[name] | safe -}}
  </svg>
{% endmacro %}
