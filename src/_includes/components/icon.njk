{% macro icon(name, size=24, rotate=0, class="", title="") %}
  {#
    Three viewBoxes now: the chevron is on a 28-unit grid, the wordmark on 40,
    everything else on 24. Sizing is handled by width/height, so the difference
    is invisible to callers — but it must be honoured here or the glyph crops.
  #}
  {%- if name == "chevron-down" -%}{%- set box = "0 0 28 28" -%}
  {%- elif name == "logo-mark" -%}{%- set box = "0 0 40 40" -%}
  {%- else -%}{%- set box = "0 0 24 24" -%}{%- endif -%}
  <svg
    class="icon icon--{{ name }}{% if class %} {{ class }}{% endif %}"
    width="{{ size }}" height="{{ size }}" viewBox="{{ box }}"
    fill="none" focusable="false"
    {%- if rotate %} style="transform: rotate({{ rotate }}deg)"{% endif %}
    {%- if title %} role="img" aria-label="{{ title }}"{% else %} aria-hidden="true"{% endif %}>
    {{- paths[name] | safe -}}
  </svg>
{% endmacro %}
