{#
  STAT CARD — a label above a large number.

  PROPS
    label  the caption (required)
    value  the number, rendered large (required)

  Pairs with education-card.njk in the At a Glance grid; the two share a card
  shell in _stat-card.css and differ only in type scale.
#}

{% macro statCard(label, value) %}
  <div class="stat-card">
    <p class="stat-card-label">{{ label }}</p>
    <p class="stat-card-value">{{ value }}</p>
  </div>
{% endmacro %}
