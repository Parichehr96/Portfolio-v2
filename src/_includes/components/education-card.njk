{#
  EDUCATION CARD — a degree: field on top, credential beneath.

  Inverted emphasis relative to stat-card (big text first, small text second),
  which is why it is its own component rather than a stat-card variant.

  PROPS
    field       "Industrial Design" (required)
    credential  "Bachelor at AUI" (required)
    institution full name — title attribute only, for the abbreviation
#}

{% macro educationCard(field, credential, institution="") %}
  <div class="stat-card stat-card--edu">
    <p class="edu-card-field">{{ field }}</p>
    <p class="stat-card-label"{% if institution %} title="{{ institution }}"{% endif %}>{{ credential }}</p>
  </div>
{% endmacro %}
