{#
  BUTTON (primary) — the dashed pill.

  ONE component covers every primary control on the site: the hero scroll CTA,
  the carousel arrows, "View All Projects" and the Snake retry. They differ only
  in props, never in markup, which is what stops the dashed-border SVG treatment
  (scripts/button-fill.js) from having to special-case four near-identical
  classes the way it used to.

  PROPS
    label     text; omit for an icon-only button
    href      renders an <a>; without it you get a <button type=button>
    iconName  key from components/icon.njk
    iconOnly  true → no label element at all, `aria` becomes the accessible name
    rotate    passed to the icon (arrows reuse the chevron)
    aria      accessible name — REQUIRED when iconOnly, ignored otherwise
    class     extra classes for placement (never for restyling — see COMPONENTS.md)
    attrs     raw attribute string for one-off hooks (data-*, aria-controls)
    download  filename → adds download + target=_blank + rel

  USAGE
    {% raw %}{% from "components/button.njk" import button %}
    {{ button(label="View All Projects", href="/projects/", iconName="chevron-down", rotate=-90) }}
    {{ button(iconOnly=true, iconName="chevron-down", rotate=90, aria="Next project") }}{% endraw %}
#}

{% from "components/icon.njk" import icon %}

{% macro button(label="", href="", iconName="", iconOnly=false, rotate=0, aria="", class="", attrs="", download="") %}
  {%- set tag = "a" if href else "button" -%}
  <{{ tag }}
    class="btn-primary{% if iconName %} show-icon{% endif %}{% if iconOnly %} btn-primary--icon{% endif %}{% if class %} {{ class }}{% endif %}"
    {%- if href %} href="{{ href }}"{% else %} type="button"{% endif %}
    {%- if download %} download="{{ download }}" target="_blank" rel="noopener noreferrer"{% endif %}
    {%- if aria %} aria-label="{{ aria }}"{% endif %}
    {%- if attrs %} {{ attrs | safe }}{% endif %}>
    {%- if label and not iconOnly %}<span class="btn-primary-label">{{ label }}</span>{% endif -%}
    {%- if iconName %}<span class="btn-primary-icon">{{ icon(iconName, rotate=rotate) }}</span>{% endif -%}
  </{{ tag }}>
{% endmacro %}
